# Copy to .env — .env is gitignored and must never be committed.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Register commands to one guild for instant availability while developing.
# Leave blank in production to register globally.
DEV_GUILD_ID=

DATABASE_PATH=./data/uml.sqlite
HEALTH_PORT=8080
LOG_LEVEL=info

# Phase 3 — the OCR microservice. Hosted separately from this bot (§2, §3).
# Leave blank to run without OCR: result submission falls back to manual entry.
OCR_SERVICE_URL=
OCR_SERVICE_KEY=
OCR_TIMEOUT_MS=60000
